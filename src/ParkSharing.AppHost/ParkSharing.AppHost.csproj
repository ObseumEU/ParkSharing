<Project Sdk="Microsoft.NET.Sdk">
	<Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAspireHost>true</IsAspireHost>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Hosting" Version="13.5.3" />
		<PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.3" />
		<PackageReference Include="Aspire.Hosting.MongoDB" Version="13.5.3" />
		<PackageReference Include="Aspire.Hosting.NodeJs" Version="8.2.2" />
		<PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.5.3" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ParkSharing.Admin.Server\ParkSharing.Admin.Server.csproj" />
	  <ProjectReference Include="..\ParkSharing.Notification.Server\ParkSharing.Notification.Server.csproj" />
	  <ProjectReference Include="..\ParkSharing.Reservation.Server\ParkSharing.Reservation.Server.csproj" />
	</ItemGroup>

	<Target Name="RestoreNpm" BeforeTargets="Build" Condition=" '$(DesignTimeBuild)' != 'true' ">
		<ItemGroup>
			<PackageJsons Include="..\*\package.json" />
		</ItemGroup>

		<!-- Install npm packages if node_modules is missing -->
		<Message Importance="Normal" Text="Installing npm packages for %(PackageJsons.RelativeDir)" Condition="!Exists('%(PackageJsons.RootDir)%(PackageJsons.Directory)/node_modules')" />
		<Exec Command="npm install" WorkingDirectory="%(PackageJsons.RootDir)%(PackageJsons.Directory)" Condition="!Exists('%(PackageJsons.RootDir)%(PackageJsons.Directory)/node_modules')" />
	</Target>

</Project>
